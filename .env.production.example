# Variables consommees par docker-compose.prod.yml (a saisir dans la configuration de l'hebergement, pas
# de fichier .env copie dans l'image en prod). A garder synchronise avec le bloc
# `environment:` de docker-compose.prod.yml si l'un des deux change.

APP_PORT=8000

# genere une fois avec `php artisan key:generate --show`, colle la valeur ici.
# Ne JAMAIS regenerer a chaque deploiement : ca invalide sessions/cookies/donnees
# chiffrees existantes.
APP_KEY=

# URL publique HTTPS du back.
APP_URL=https://api.safe-campus.example

DB_DATABASE=sc_back
DB_USERNAME=
# mot de passe fort (min. 20 caracteres, aleatoire), jamais celui du .env dev.
DB_PASSWORD=

# URL publique du front (Nuxt), pour CORS et Sanctum stateful.
# CORS_ALLOWED_ORIGINS : origines completes (schema + hote), separees par des virgules.
CORS_ALLOWED_ORIGINS=https://safe-campus.example
SANCTUM_STATEFUL_DOMAINS=safe-campus.example

# Reverse proxy de l'hebergeur qui termine le HTTPS : `*` si le conteneur n'est
# joignable que par lui (Render, tunnel...), sinon IP/CIDR du proxy. Vide = aucun.
# Sans cela : URL generees en http://, IP du proxy dans l'audit et la limite de debit.
TRUSTED_PROXIES=*
# `true` par defaut (S-13). A mettre a `false` seulement pour tester l'image en
# HTTP sur localhost : le cookie de session de /admin ne passerait pas.
SESSION_SECURE_COOKIE=true

# Compte visiteur unique consomme par le front pour authentifier l'acces
# public au site (POST /api/login, token Sanctum Bearer). A definir avec un
# mot de passe dedie, different de celui du dev local.
VISITEUR_EMAIL=visiteur@safe-campus.example
VISITEUR_PASSWORD=

# Optionnel : hebergeur sans commande post-deploiement ni disque persistant (Render
# gratuit). docker/8.4/start-prod lit ces variables au demarrage ; desactivees par defaut.
# RUN_MIGRATIONS=true : lance `migrate --force` avant de servir.
# DEMO_CONTENT=true   : rejoue les seeders de demo (documents, histoires) et recree leurs
#                       fichiers. Demo publique uniquement, jamais en production reelle.
# Avec DEMO_CONTENT, un compte redacteur de demo est cree : mot de passe long et aleatoire.
RUN_MIGRATIONS=false
DEMO_CONTENT=false
REDACTEUR_DEMO_EMAIL=
REDACTEUR_DEMO_PASSWORD=

# Premier compte admin (attribution des roles), cree au premier migrate. Mot de
# passe fort obligatoire (14 caracteres min., majuscule, minuscule, caractere
# special). Ne sert qu'a la creation : peut etre retire ensuite.
ADMIN_EMAIL=admin@safe-campus.example
ADMIN_PASSWORD=
