#!/usr/bin/env bash
set -e

# Commande explicite (docker compose run) : execution directe
if [ $# -gt 0 ]; then
    exec "$@"
fi

# filet de securite : recupere vendor/ si un run precedent (ex. exec -u root) l'a pollue en root:root
[ -d vendor ] && sudo chown -R scback:scback vendor

# composer install declenche filament:upgrade (post-autoload-dump), qui publie les assets
COMPOSER_MEMORY_LIMIT=-1 composer install --no-interaction

exec php artisan serve --host=0.0.0.0 --port="${APP_PORT:-8000}"
